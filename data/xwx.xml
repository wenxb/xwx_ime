<?xml version="1.0" encoding="UTF-8"?>
<!--
   xwx 的 component XML。`just install` 把 __XWX_EXEC__ 替换成二进制路径后，
   装到 /usr/share/ibus/component/xwx.xml（必须是系统目录，IBus 不扫 ~/.local/share）。
-->
<component>
  <name>org.freedesktop.IBus.Engine.xwx</name>
  <description>XWX 拼音输入法（Rust 实现）</description>
  <version>0.1.0</version>
  <license>MIT</license>
  <author>xwx</author>
  <homepage></homepage>
  <exec>__XWX_EXEC__ --ibus</exec>
  <textdomain></textdomain>
  <engines>
    <engine>
      <name>xwx</name>
      <longname>XWX 拼音</longname>
      <description>XWX 拼音输入法（Rust 实现）</description>
      <language>zh_CN</language>
      <license>MIT</license>
      <author>xwx</author>
      <icon></icon>
      <layout>us</layout>
      <rank>0</rank>
      <hotkeys></hotkeys>
      <symbol></symbol>
      <setup></setup>
      <layout_variant></layout_variant>
      <layout_option></layout_option>
      <version>0.1.0</version>
      <textdomain></textdomain>
      <icon_prop_key></icon_prop_key>
    </engine>
  </engines>
</component>
