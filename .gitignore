# ---- Cargo / Rust ----
/target/

# ---- 生成的数据产物（不应当入库）----
# 词库二进制：scripts/dict_to_bin.py 从 SQLite/Rime 构建而来，应通过
# `just install` / 发布物分发，而不是进 git。
data/dict.bin
# 简拼(首字母)副索引:scripts/abbrev_to_bin.py 从 dict.bin 生成(约 69 MB),
# 与 dict.bin 同等对待,通过 `just install` / 发布物分发,不进 git。
data/abbrev.bin
# 音节级词典转移索引:scripts/build_syllable_graph.py 从 dict.bin 生成(约 59 MB),
# 与 dict.bin/abbrev.bin 同等对待;引擎缺它时**自动回退**到逐音节二分(不是错误),
# 所以同样不进 git,由发布物 / 本机重新生成。
data/syllable_graph.bin
data/*.sqlite3

# 语言模型（文本或未来的 mmap 二进制格式），由语料训练生成
data/bigram.txt
data/bigram.bin

# 打 deb 时 `just deb` 生成的 component XML（构建产物）；
# 手写的模板 data/xwx.xml、钩子 data/debian/postinst 保留入库。
data/debian/xwx.xml

# ---- Python ----
__pycache__/
*.pyc

# 评测样本:scripts/build_eval.py 从 dict.bin 生成(4MB),
# 与词库绑定,换词库要重新生成,不入库。
scripts/eval_samples.jsonl

# ---- 编辑器 / 系统垃圾 ----
*.swp
*.swo
*~
.DS_Store
# Playwright MCP 的会话产物(截图/页面快照),与仓库无关。
.playwright-mcp/
# ---- rime oracle (对照工具) ----
tools/rime_oracle/.rime_user/
tools/rime_oracle/rime_oracle

# 简拼路线 spike 的原型产物(69MB),用完即弃、可由 spike.py 重新生成。
# spike 的 .py 脚本保留入库:它们是「为什么选路线 (c)」的实测证据。
tools/spike_abbrev/*.bin

# 用户本地文件（会话/agent 约定:保持未跟踪,别提交）
AGENTS.md
.dsh-worktrees/
tools/typing_sim/data/
