# ---- Cargo / Rust ----
/target/

# ---- 生成的数据产物（不应当入库）----
# 词库二进制：scripts/dict_to_bin.py 从 SQLite/Rime 构建而来，应通过
# `just install` / 发布物分发，而不是进 git。
data/dict.bin
# 简拼(首字母)副索引:scripts/abbrev_to_bin.py 从 dict.bin 生成(约 69 MB),
# 与 dict.bin 同等对待,通过 `just install` / 发布物分发,不进 git。
data/abbrev.bin
# 音节级词典转移索引:scripts/build_syllable_graph.py 从 dict.bin 生成(约 59 MB),
# 与 dict.bin/abbrev.bin 同等对待;引擎缺它时**自动回退**到逐音节二分(不是错误),
# 所以同样不进 git,由发布物 / 本机重新生成。
data/syllable_graph.bin
data/*.sqlite3
# 英文词库二进制:scripts/build_english_dict.py 从 wordfreq/条目表构建(约 4 MB),
# 与 dict.bin 同等对待,通过发布物分发,不进 git。
data/english.bin
# M2 静态二元数据,同样不进 git。
data/english_bigram.bin
# 构建报告(计数/格式描述),build_english_dict.py 生成,与 english.bin 同源。
data/english.meta.json

# 语言模型（文本或未来的 mmap 二进制格式），由语料训练生成
data/bigram.txt
data/bigram.bin

# 万象 .gram（约 400 MB），非本仓产物、上游单独下载：仓库里放一份只为
# examples 的默认路径（probe.rs 的 `data/wanxiang-lts-zh-hans.gram`）
# 开箱可用，绝不入库。**别改成硬链接**：data/README.md 记过「训练脚本把
# 该路径就地覆盖」的事故，硬链接会让一次误跑同时毁掉两份。
data/*.gram

# 打 deb 时 `just deb` 生成的 component XML（构建产物）；
# 手写的模板 data/xwx.xml、钩子 data/debian/postinst 保留入库。
data/debian/xwx.xml

# ---- Python ----
__pycache__/
*.pyc

# 评测样本:scripts/build_eval.py 从 dict.bin 生成(4MB),
# 与词库绑定,换词库要重新生成,不入库。
scripts/eval_samples.jsonl

# ---- 编辑器 / 系统垃圾 ----
*.swp
*.swo
*~
.DS_Store
node_modules/
# Playwright MCP 的会话产物(截图/页面快照),与仓库无关。
.playwright-mcp/
# 分阶段验证产物(测试日志、评测输出、验收报告、hash 清单),按
# docs/english-input/05-execution-tests.md 的约定统一落在这里:
# 可由命令重新生成,不是源码,不入库。
artifacts/
# ---- rime oracle (对照工具) ----
tools/rime_oracle/.rime_user/
tools/rime_oracle/rime_oracle

# 简拼路线 spike 的原型产物(69MB),用完即弃、可由 spike.py 重新生成。
# spike 的 .py 脚本保留入库:它们是「为什么选路线 (c)」的实测证据。
tools/spike_abbrev/*.bin

# 用户本地文件（会话/agent 约定:保持未跟踪,别提交）
AGENTS.md
.dsh-worktrees/
tools/typing_sim/data/
# 误生成的 pnpm 空壳(无依赖,Rust 仓库没有 JS 工具链),保留本地不入库。
package.json
pnpm-lock.yaml
